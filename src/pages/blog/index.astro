---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getPublishedPosts } from '../../lib/posts';

const posts = await getPublishedPosts();
---

<BaseLayout title="Blog">
  <div class="wrap page">
    <p class="label">blog</p>
    <h1>Blog</h1>
    {
      posts.length === 0 ? (
        <p class="dim list">No posts yet — check back soon.</p>
      ) : (
        <ul class="rows list">
          {posts.map((post) => (
            <li>
              <div>
                <h2 class="row-title">
                  <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                </h2>
                <p>{post.data.description}</p>
              </div>
              <time class="meta" datetime={post.data.pubDate.toISOString()}>
                {formatDate(post.data.pubDate)}
              </time>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>

<style>
  .list {
    margin-top: 2rem;
  }

  .row-title {
    font-size: 1rem;
    font-weight: 500;
  }
</style>
