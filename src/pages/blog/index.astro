---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import { formatDate, getPublishedPosts } from '../../lib/posts';

const posts = await getPublishedPosts();
---

<BaseLayout title="Blog">
  <div class="container page">
    <SectionTitle title="Blog" level={1} />
    {
      posts.length === 0 ? (
        <p class="list">No posts yet — check back soon.</p>
      ) : (
        <ul class="post-list list">
          {posts.map((post) => (
            <li>
              <h2>
                <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              </h2>
              <time class="muted" datetime={post.data.pubDate.toISOString()}>
                {formatDate(post.data.pubDate)}
              </time>
              <p>{post.data.description}</p>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>

<style>
  .list {
    margin-top: 2rem;
  }
</style>
