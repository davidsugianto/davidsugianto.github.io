---
import { site } from '../data/site';
---

<div id="hero" class="hero">
  <div class="wrap">
    <img src={site.avatar} alt={site.name} width="84" height="84" />
    <h1>{site.name}<span class="cur" aria-hidden="true">▋</span></h1>
    <p class="tag">{site.role} · {site.location}</p>
    <p class="sub"><span class="cmt">// </span>{site.description}</p>
    <div class="cta">
      <a class="btn fill" href="/DAVID_SUGIANTO_RESUME.pdf" download="DAVID_SUGIANTO_RESUME.pdf">download resume</a>
      <a class="btn" href={`mailto:${site.email}`}>email</a>
      {site.socials.map(({ label, href }) => <a class="btn" href={href} rel="me noopener" target="_blank">{label.toLowerCase()}</a>)}
    </div>
  </div>
</div>

<style>
  .hero {
    padding: 64px 0 56px;
    border-bottom: 1px solid var(--line);
  }

  img {
    display: block;
    width: 84px;
    height: 84px;
    margin-bottom: 18px;
    border: 1px solid var(--line);
    border-radius: 4px;
  }

  h1 {
    font-size: clamp(2.6rem, 9vw, 4.4rem);
    line-height: 1;
  }

  .tag {
    margin: 0.55em 0 0;
    font-size: clamp(1.05rem, 3vw, 1.4rem);
    font-weight: 500;
  }

  .sub {
    margin: 1.1em 0 0;
    max-width: 62ch;
    color: var(--dim);
    font-size: 0.95rem;
    line-height: 1.75;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  .wrap > * {
    opacity: 0;
    animation: rise 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
  }

  .wrap > :nth-child(1) {
    animation-delay: 0.05s;
  }

  .wrap > :nth-child(2) {
    animation-delay: 0.15s;
  }

  .wrap > :nth-child(3) {
    animation-delay: 0.25s;
  }

  .wrap > :nth-child(4) {
    animation-delay: 0.35s;
  }

  .wrap > :nth-child(5) {
    animation-delay: 0.45s;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wrap > * {
      opacity: 1;
    }
  }
</style>
