---
import SocialIcons from './SocialIcons.astro';
import { site } from '../data/site';
---

<div id="hero" class="hero">
  <div class="gradient" aria-hidden="true"></div>
  <svg class="pattern" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <pattern id="hero-grid" x="50%" y="-1" width="200" height="200" patternUnits="userSpaceOnUse">
        <path d="M.5 200V.5H200" fill="none" />
      </pattern>
      <pattern id="hero-symbols" width="400" height="400" patternUnits="userSpaceOnUse">
        <text class="symbol" font-family="monospace" x="50" y="50" font-size="24" transform="rotate(-15 50 50)">&lt;/&gt;</text>
        <text class="symbol" font-family="monospace" x="150" y="100" font-size="20" transform="rotate(10 150 100)">{'{}'}</text>
        <text class="symbol" font-family="monospace" x="250" y="80" font-size="18" transform="rotate(-5 250 80)">=&gt;</text>
        <text class="symbol" font-family="monospace" x="100" y="200" font-size="22" transform="rotate(15 100 200)">[]</text>
        <text class="symbol" font-family="monospace" x="300" y="180" font-size="20" transform="rotate(-10 300 180)">&lt;&gt;</text>
        <text class="symbol" font-family="monospace" x="200" y="250" font-size="24" transform="rotate(5 200 250)">()</text>
        <text class="symbol" font-family="monospace" x="50" y="320" font-size="18" transform="rotate(-8 50 320)">::</text>
        <text class="symbol" font-family="monospace" x="350" y="300" font-size="22" transform="rotate(12 350 300)">==</text>
        <text class="symbol" font-family="monospace" x="150" y="350" font-size="20" transform="rotate(-15 150 350)">++</text>
        <text class="symbol" font-family="monospace" x="250" y="370" font-size="24" transform="rotate(8 250 370)">;</text>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#hero-symbols)" opacity="0.2"></rect>
    <rect width="100%" height="100%" fill="url(#hero-grid)"></rect>
  </svg>

  <div class="content">
    <p class="hello fade">Hello! 👋</p>
    <h1 class="fade d2">I'm <span class="name">{site.name}</span></h1>
    <p class="role fade d4">{site.role}</p>
    <p class="cta fade d4">
      <a class="button button-primary" href="/DAVID_SUGIANTO_RESUME.pdf" download="DAVID_SUGIANTO_RESUME.pdf">Download resume (PDF)</a>
    </p>
  </div>

  <div class="socials fade d6">
    <SocialIcons size={28} />
  </div>
</div>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--bg);
    /* Top clears the wrapped mobile nav (3 rows, ~135px); matches .page. */
    padding-block: 9rem 10rem;
  }

  .gradient {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(
      ellipse 800px 1200px at 0% 0%,
      color-mix(in srgb, var(--accent) 25%, transparent) 0%,
      color-mix(in srgb, var(--accent) 15%, transparent) 20%,
      color-mix(in srgb, var(--accent) 6%, transparent) 40%,
      transparent 70%
    );
  }

  .pattern {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    -webkit-mask-image: radial-gradient(100% 100% at top right, white, transparent);
    mask-image: radial-gradient(100% 100% at top right, white, transparent);
  }

  .pattern path {
    stroke: var(--border);
  }

  .symbol {
    fill: var(--accent);
  }

  .content,
  .socials {
    padding-inline: 2rem;
  }

  .hello {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--muted);
  }

  h1 {
    margin: 1.5rem 0 0;
    font-size: 2.25rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }

  .name {
    color: var(--accent);
  }

  .role {
    margin: 1rem 0 0;
    font-size: 1rem;
    font-weight: 500;
    color: var(--muted);
  }

  .cta {
    margin: 2rem 0 0;
  }

  .socials {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding-block: 2rem;
    color: var(--muted);
  }

  .socials :global(.social-icons) {
    gap: 1.5rem;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .fade {
    opacity: 0;
    animation: fadeIn 0.8s ease-out forwards;
  }

  .d2 {
    animation-delay: 0.2s;
  }

  .d4 {
    animation-delay: 0.4s;
  }

  .d6 {
    animation-delay: 0.6s;
  }

  @media (prefers-reduced-motion: reduce) {
    .fade {
      animation: none;
      opacity: 1;
    }
  }

  @media (min-width: 640px) {
    .content,
    .socials {
      padding-inline: 3rem;
    }

    .socials {
      padding-block: 3rem;
    }

    .hello {
      font-size: 1.5rem;
    }

    h1 {
      margin-top: 2rem;
      font-size: 3rem;
    }

    .role {
      margin-top: 1.5rem;
      font-size: 1.125rem;
    }
  }

  @media (min-width: 768px) {
    .hero {
      display: flex;
      align-items: center;
      min-height: 100svh;
      padding-block: 0;
    }

    .content,
    .socials {
      padding-inline: 6rem;
    }

    .socials {
      padding-block: 6rem;
    }

    .socials :global(.social-icons) {
      gap: 2rem;
    }

    .hello {
      font-size: 3rem;
    }

    h1 {
      margin-top: 2.5rem;
      font-size: 3.75rem;
    }

    .role {
      margin-top: 2rem;
      font-size: 1.25rem;
    }
  }

  @media (min-width: 1024px) {
    h1 {
      font-size: 6rem;
    }
  }
</style>
