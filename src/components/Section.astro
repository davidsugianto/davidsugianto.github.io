---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
const label = title.toLowerCase().replace(/\s+/g, '_');
---

<section id={id} class="section">
  <div class="wrap">
    <h2 class="label">{label}</h2>
    <slot />
  </div>
</section>

<style>
  .section {
    padding: 54px 0;
    border-bottom: 1px solid var(--line);
  }
</style>
