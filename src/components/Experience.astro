---
import Section from './Section.astro';
import { experience } from '../data/resume';
---

<Section id="experience" title="Experience">
  <div class="jobs">
    {
      experience.map((item) => (
        <article class="panel">
          <div class="bar">
            <span class="company">{item.company}</span>
            <span>{item.period}</span>
          </div>
          <div class="body">
            <h3>{item.role}</h3>
            {item.summary && <p class="cmt">// {item.summary}</p>}
            {item.highlights.length > 0 && (
              <ul class="adds">
                {item.highlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>
            )}
          </div>
        </article>
      ))
    }
  </div>
</Section>

<style>
  .jobs {
    display: grid;
    gap: 20px;
  }

  .panel {
    border: 1px solid var(--line);
    border-radius: 4px;
    overflow: hidden;
    background: var(--panel);
  }

  .bar {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 14px;
    border-bottom: 1px solid var(--line);
    color: var(--dim);
    font-size: 0.74rem;
  }

  .company {
    color: var(--amber);
  }

  .body {
    padding: 14px 16px;
  }

  h3 {
    font-size: 1.05rem;
  }

  .cmt {
    margin: 6px 0 0;
    font-size: 0.88rem;
  }

  .adds {
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 6px;
  }

  .adds li {
    position: relative;
    padding-left: 2ch;
    font-size: 0.88rem;
    line-height: 1.7;
  }

  .adds li::before {
    content: '+';
    position: absolute;
    left: 0;
    color: var(--grn);
  }
</style>
