---
interface Props {
  title: string;
  level?: 1 | 2;
}

const { title, level = 2 } = Astro.props;
const Heading = level === 1 ? 'h1' : 'h2';
---

<Heading class="section-title">{title}</Heading>
<div class="bar" aria-hidden="true"></div>

<style>
  .section-title {
    margin: 0;
    font-size: 1.875rem;
    font-weight: 700;
    line-height: 1.1;
  }

  .bar {
    width: 75px;
    height: 5px;
    margin-top: 0.5rem;
    border-radius: 999px;
    background: var(--accent);
  }

  @media (min-width: 640px) {
    .section-title {
      font-size: 2.25rem;
    }
  }

  @media (min-width: 768px) {
    .section-title {
      font-size: 3rem;
    }
  }

  @media (min-width: 1280px) {
    .section-title {
      font-size: 4.5rem;
    }
  }
</style>
