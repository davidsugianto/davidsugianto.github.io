---
import Section from './Section.astro';
import { education } from '../data/resume';
---

<Section id="education" title="Education">
  {
    education.map((item) => (
      <article class="timeline-card">
        <header>
          <div>
            <h3>{item.degree}</h3>
            <p class="company">{item.school}</p>
          </div>
          <span class="period">{item.period}</span>
        </header>
      </article>
    ))
  }
</Section>
