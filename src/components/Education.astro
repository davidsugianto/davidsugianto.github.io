---
import Section from './Section.astro';
import { education } from '../data/resume';
---

<Section id="education" title="Education">
  <ul class="rows">
    {
      education.map((item) => (
        <li>
          <div>
            <strong>{item.degree}</strong>
            <p>{item.school}</p>
          </div>
          <span class="meta">{item.period}</span>
        </li>
      ))
    }
  </ul>
</Section>
