---
import Section from './Section.astro';
import { site } from '../data/site';
import { skills } from '../data/resume';
---

<Section id="about" title="About Me">
  <p>{site.summary}</p>
  <ul class="skills">
    {skills.flatMap(({ items }) => items).map((item) => <li class="skill">{item}</li>)}
  </ul>
</Section>

<style>
  p {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.625;
    color: var(--muted);
  }

  .skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 2rem 0 0;
    padding: 1rem 0 0;
    list-style: none;
  }

  .skill {
    padding: 0.375rem 0.75rem;
    border-radius: 999px;
    background: var(--chip);
    color: var(--fg);
    font-size: 0.875rem;
    font-weight: 500;
    transition: background-color 0.2s;
  }

  .skill:hover {
    background: var(--border);
  }

  @media (min-width: 640px) {
    p {
      font-size: 1.25rem;
    }

    .skill {
      padding: 0.5rem 1rem;
      font-size: 1rem;
    }
  }

  @media (min-width: 768px) {
    p {
      font-size: 1.5rem;
    }

    .skill {
      font-size: 1.125rem;
    }
  }
</style>
