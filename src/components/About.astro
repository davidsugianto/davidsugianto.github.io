---
import Section from './Section.astro';
import { site } from '../data/site';
import { skills } from '../data/resume';
---

<Section id="about" title="About Me">
  <p class="summary">{site.summary}</p>
  <ul class="skills" aria-label="Skills">
    {skills.flatMap(({ items }) => items).map((item) => <li>{item}</li>)}
  </ul>
</Section>

<style>
  .summary {
    margin: 0;
    max-width: 68ch;
    font-size: 1rem;
    line-height: 1.75;
  }

  .skills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .skills li {
    padding: 2px 10px;
    border: 1px solid var(--line);
    border-radius: 2px;
    background: var(--panel);
    color: var(--dim);
    font-size: 0.82rem;
    transition: color 0.12s, border-color 0.12s;
  }

  .skills li:hover {
    color: var(--amber);
    border-color: var(--amber);
  }
</style>
