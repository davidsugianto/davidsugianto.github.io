---
import { site } from '../data/site';

const links = [
  { label: 'About', href: '/#about' },
  { label: 'Projects', href: '/#projects' },
  { label: 'Experience', href: '/#experience' },
  { label: 'Education', href: '/#education' },
];
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <img src={site.avatar} alt="" width="40" height="40" />
    <p class="prompt"><span class="p">~/davidsugianto ❯</span> <span class="cur" aria-hidden="true">▋</span></p>
    <nav class="meta" aria-label="Footer">
      {links.map(({ label, href }, i) => <>{i > 0 && ' · '}<a href={href}>{label.toLowerCase()}</a></>)}
    </nav>
    <p class="meta">
      © {year} {site.name} · <a href={`mailto:${site.email}`}>email</a>{site.socials.map(({ label, href }) => <> · <a href={href} rel="me noopener" target="_blank">{label.toLowerCase()}</a></>)}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    padding: 52px 0 64px;
  }

  img {
    display: block;
    width: 40px;
    height: 40px;
    margin-bottom: 16px;
    border-radius: 4px;
    opacity: 0.85;
  }

  .prompt {
    margin: 0;
    font-size: 0.9rem;
  }

  .p {
    color: var(--grn);
  }

  .meta {
    margin: 1.2em 0 0;
    color: var(--dim);
    font-size: 0.84rem;
  }
</style>
