---
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const isHome = path === '/';
const links = [
  { label: 'About', href: '/#about' },
  { label: 'Projects', href: '/#projects' },
  { label: 'Experience', href: '/#experience' },
  { label: 'Education', href: '/#education' },
];
---

<header id="site-header" class="site-header" data-solid={isHome ? undefined : ''}>
  <nav aria-label="Main">
    <ul>
      {
        links.map(({ label, href }) => (
          <li>
            <a href={href}>{label}</a>
          </li>
        ))
      }
    </ul>
    <ThemeToggle />
  </nav>
</header>

<script>
  const header = document.getElementById('site-header');
  if (header && !header.hasAttribute('data-solid')) {
    const update = () => header.toggleAttribute('data-solid', window.scrollY > 100);
    window.addEventListener('scroll', update, { passive: true });
    update();
  }
</script>

<style>
  .site-header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    transition: background-color 0.3s;
  }

  .site-header[data-solid] {
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.75rem 2rem;
    max-width: 80rem;
    margin-inline: auto;
    padding: 1rem 2rem;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    color: var(--muted);
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s;
  }

  nav a:hover {
    color: var(--fg);
  }

  nav a[aria-current='page'] {
    color: var(--accent);
  }

  @media (max-width: 639px) {
    nav,
    ul {
      gap: 0.5rem 1.25rem;
    }

    nav a {
      font-size: 0.9rem;
    }
  }

  @media (min-width: 768px) {
    .site-header {
      position: fixed;
    }
  }
</style>
