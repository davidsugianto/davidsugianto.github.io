---
import ThemeToggle from './ThemeToggle.astro';

const tabs = [
  { id: 'about', label: 'about.md' },
  { id: 'projects', label: 'projects.md' },
  { id: 'experience', label: 'experience.md' },
  { id: 'education', label: 'education.md' },
];
---

<header class="chrome">
  <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
  <a class="file" href="/">~/davidsugianto</a>
  <nav class="tabs" aria-label="Main">
    {tabs.map(({ id, label }) => <a class="tab" href={`/#${id}`} data-section={id}>{label}</a>)}
  </nav>
  <ThemeToggle />
</header>

<script>
  const tabs = [...document.querySelectorAll<HTMLAnchorElement>('.chrome .tab')];
  const sections = tabs.map((t) => document.getElementById(t.dataset.section ?? '')).filter((s) => s !== null);
  if (sections.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) tabs.forEach((t) => t.classList.toggle('on', t.dataset.section === entry.target.id));
        }
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((s) => observer.observe(s));
  }
</script>

<style>
  .chrome {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--chrome);
    border-bottom: 1px solid var(--line);
    padding: 9px 16px;
    font-size: 12px;
  }

  .dots {
    display: flex;
    gap: 7px;
  }

  .dots i {
    display: block;
    width: 11px;
    height: 11px;
    border-radius: 50%;
  }

  .dots i:nth-child(1) {
    background: var(--red);
  }

  .dots i:nth-child(2) {
    background: var(--amber);
  }

  .dots i:nth-child(3) {
    background: var(--grn);
  }

  .file {
    color: var(--dim);
    border: 0;
  }

  .file:hover {
    color: var(--amber);
  }

  .tabs {
    display: flex;
    gap: 4px;
    min-width: 0;
    overflow-x: auto;
  }

  .tab {
    color: var(--dim);
    border: 1px solid transparent;
    border-radius: 3px;
    padding: 2px 9px;
    white-space: nowrap;
    transition: color 0.12s, background 0.12s;
  }

  .tab:hover {
    color: var(--amber);
    background: var(--panel);
  }

  .tab.on {
    color: var(--fg);
    background: var(--panel);
    border-color: var(--line);
  }

  @media (max-width: 560px) {
    .file {
      display: none;
    }
  }
</style>
