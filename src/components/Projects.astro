---
import Section from './Section.astro';
import { projects } from '../data/portfolio';
---

<Section id="projects" title="Projects">
  <div class="projects">
    {
      projects.map((project, index) => (
        <article id={project.slug} class="project">
          <span class="num">{String(index + 1).padStart(2, '0')}</span>
          <h3>{project.title}</h3>
          <p>{project.description}</p>
          <ul class="stack" aria-label="Tech stack">
            {project.stack.map((tech) => (
              <li>{tech}</li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</Section>

<style>
  .projects {
    display: grid;
    gap: 2rem;
  }

  .project {
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    background: var(--surface);
  }

  .num {
    font-size: 0.875rem;
    color: var(--accent);
  }

  h3 {
    margin: 0.25rem 0 1rem;
    font-size: 1.25rem;
    font-weight: 700;
  }

  p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.625;
    color: var(--muted);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin: 1rem 0 0;
    padding: 0.5rem 0 0;
    list-style: none;
  }

  .stack li {
    padding: 0.25rem 0.625rem;
    border-radius: 0.375rem;
    background: var(--fg);
    color: var(--bg);
    font-size: 0.75rem;
    font-weight: 500;
  }

  @media (min-width: 640px) {
    .project {
      padding: 1.5rem;
      border-radius: 1rem;
    }

    h3 {
      font-size: 1.5rem;
    }

    p {
      font-size: 1.125rem;
    }

    .stack {
      gap: 0.5rem;
    }

    .stack li {
      padding: 0.375rem 0.75rem;
      border-radius: 0.5rem;
      font-size: 0.875rem;
    }
  }

  @media (min-width: 768px) {
    .project {
      padding: 2rem;
    }
  }
</style>
