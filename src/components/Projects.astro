---
import Section from './Section.astro';
import { projects } from '../data/portfolio';
---

<Section id="projects" title="Projects">
  <ol class="ladder">
    {
      projects.map((project) => (
        <li id={project.slug}>
          <div>
            <h3>{project.title}</h3>
            <p>{project.description}</p>
            <ul class="stack" aria-label="Tech stack">
              {project.stack.map((tech) => (
                <li>{tech}</li>
              ))}
            </ul>
          </div>
        </li>
      ))
    }
  </ol>
</Section>

<style>
  .ladder {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: r;
  }

  .ladder > li {
    counter-increment: r;
    display: flex;
    gap: 16px;
    align-items: baseline;
    padding: 16px 0;
  }

  .ladder > li + li {
    border-top: 1px solid var(--line);
  }

  .ladder > li::before {
    content: counter(r, decimal-leading-zero);
    color: var(--grn);
    font-weight: 700;
    min-width: 2.4ch;
  }

  h3 {
    font-size: 1rem;
  }

  p {
    margin: 4px 0 0;
    color: var(--dim);
    font-size: 0.92rem;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 14px;
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
  }

  .stack li {
    color: var(--amber);
    font-size: 0.8rem;
  }
</style>
